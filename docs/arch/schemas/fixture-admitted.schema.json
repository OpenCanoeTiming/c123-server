{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencanoetiming.org/schemas/fixture-admitted.schema.json",
  "title": "Domain-state fixture admission block (TEST-ARCHITECTURE §4; ADR-017 D5)",
  "description": "The `admitted` block of a tier-2 domain-state fixture. `status: 'admitted'` is allowed only when gate1 and gate2 are true, the gate-3 mechanical check ran against published results over a window spanning whole races with mismatch 0, and gate3.human is a 'human-checked-<date> by <name>' line certifying the fixture. Anything else is a candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "gate1",
    "gate2",
    "gate3",
    "evidence"
  ],
  "properties": {
    "gate1": {
      "type": "boolean",
      "description": "determinism: two direct-injection replays and two projections byte-identical"
    },
    "gate2": {
      "type": "boolean",
      "description": "the gate-2 property checker reports no violation; never relaxed to admit"
    },
    "gate3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanical",
        "human"
      ],
      "properties": {
        "mechanical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempts",
            "fields",
            "match",
            "mismatch",
            "changedAfterWindow",
            "changedAfterWindowEqualsWindowEnd",
            "noFinalRow",
            "report",
            "against",
            "windowSpansWholeRaces"
          ],
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 0
            },
            "fields": {
              "type": "integer",
              "minimum": 0
            },
            "match": {
              "type": "integer",
              "minimum": 0
            },
            "mismatch": {
              "type": "integer",
              "minimum": 0
            },
            "changedAfterWindow": {
              "type": "integer",
              "minimum": 0
            },
            "changedAfterWindowEqualsWindowEnd": {
              "type": "integer",
              "minimum": 0
            },
            "noFinalRow": {
              "type": "integer",
              "minimum": 0
            },
            "report": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "sha256"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "against": {
              "enum": [
                "published-results",
                "window-end-xml"
              ],
              "description": "published-results: every race in the window spans the window whole and its finishers are checked against the published results (the day's final XML once the human line certifies it); window-end-xml: the weaker candidate check for a window that cuts a race"
            },
            "windowSpansWholeRaces": {
              "type": "boolean"
            }
          }
        },
        "human": {
          "type": "string",
          "description": "'human-checked-YYYY-MM-DD by <name>' once a person has compared the fixture's final values with the published results of the races in the window; any other string (e.g. a TODO) keeps the fixture a candidate"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate1",
        "gate2"
      ],
      "properties": {
        "gate1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stepLogSha256",
            "finalStateSha256",
            "candidateSha256"
          ],
          "properties": {
            "stepLogSha256": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "finalStateSha256": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "candidateSha256": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "gate2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checker",
            "violations"
          ],
          "properties": {
            "checker": {
              "type": "string"
            },
            "violations": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "candidate",
        "admitted"
      ]
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "admitted"
      }
    }
  },
  "then": {
    "properties": {
      "gate1": {
        "const": true
      },
      "gate2": {
        "const": true
      },
      "gate3": {
        "properties": {
          "mechanical": {
            "properties": {
              "mismatch": {
                "const": 0
              },
              "against": {
                "const": "published-results"
              },
              "windowSpansWholeRaces": {
                "const": true
              }
            }
          },
          "human": {
            "pattern": "^human-checked-\\d{4}-\\d{2}-\\d{2} by .+$"
          }
        }
      }
    }
  }
}
