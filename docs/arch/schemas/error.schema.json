{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencanoetiming.org/schemas/error.schema.json",
  "title": "Error",
  "description": "The error envelope shared by the on-site contract (CONTRACTS.md §7) and the live ingest contract (§8), defined once in §1.4. `code` is the contract and MUST be one of the closed values below; `message` is advisory only, for logs and humans, and may be reworded without that being a breaking change — no client or test may assert against it. `details` is present on exactly three codes and its shape follows from `code`: `validation-failed` carries `[{field, issue}]`, `write-not-possible` carries `{reason}` from the closed set of §7.3/§7.4, `source-unavailable` carries `{reason}` from the closed set of §7.1. On every other code the key is absent, never null.",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "event-not-found",
            "class-not-found",
            "course-not-found",
            "phase-not-found",
            "attempt-not-found",
            "write-not-found",
            "flag-not-found",
            "write-not-possible",
            "validation-failed",
            "vendor-payload-rejected",
            "unauthorized",
            "forbidden",
            "rate-limited",
            "source-unavailable"
          ]
        },
        "message": {
          "type": "string",
          "description": "Not part of the contract. Never parsed by a client."
        },
        "details": {
          "description": "Shape per code; see the allOf below."
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "code": { "const": "validation-failed" } } },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "type": "array",
                "description": "Every field the validator refused, by name.",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": { "type": "string" },
                    "issue": { "type": "string" }
                  },
                  "required": ["field", "issue"],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "write-not-possible" } } },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "reason": { "enum": ["run-not-closed", "team-boat", "cross", "upstream-disconnected"] }
                },
                "required": ["reason"],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "source-unavailable" } } },
          "then": {
            "required": ["details"],
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "reason": { "enum": ["not-configured", "unreadable", "invalid"] }
                },
                "required": ["reason"],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "event-not-found",
                  "class-not-found",
                  "course-not-found",
                  "phase-not-found",
                  "attempt-not-found",
                  "write-not-found",
                  "flag-not-found",
                  "vendor-payload-rejected",
                  "unauthorized",
                  "forbidden",
                  "rate-limited"
                ]
              }
            }
          },
          "then": { "not": { "required": ["details"] } }
        }
      ]
    }
  },
  "required": ["error"],
  "additionalProperties": false
}
