{
  "$schemaNote": "Format defined in CONFORMANCE-VECTORS.md. Each vector's `given` is an ordered list of synthetic observations fed to the merge function in `ingestSeq` order; `expect` (or `expectSequence`, for vectors that assert an intermediate state) is the presented envelope a correct implementation must produce. Data only — no runtime logic, per ADR-002/ADR-003 and TEST-ARCHITECTURE.md SS3.1.",
  "vectors": [

    { "id": "inv1-untouched-field-not-regressed",
      "invariant": "INV-1",
      "description": "A field with no new observation in a later message is untouched, not regressed to not-yet.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "status", "source": "tcp", "observedAt": "2026-09-15T10:14:02.083Z",
          "eventTime": "2026-09-15T10:14:02.079Z", "value": "finished", "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "upstreamRank", "source": "tcp", "observedAt": "2026-09-15T10:14:05.000Z",
          "value": 3, "confidence": "authoritative" }
      ],
      "expect": {
        "status": { "state": "known", "value": "finished", "source": "tcp", "confidence": "authoritative",
                     "eventTime": "2026-09-15T10:14:02.079Z", "provisional": false },
        "note": "status is unaffected by the unrelated upstreamRank observation at ingestSeq 2." }
    },

    { "id": "inv1-unavailable-never-defaulted",
      "invariant": "INV-1",
      "description": "A field never observed stays not-yet; it is never defaulted to unavailable merely because other fields on the same Attempt have values.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "status", "source": "tcp", "observedAt": "2026-09-15T10:00:00.000Z",
          "value": "on-course", "confidence": "authoritative" }
      ],
      "expect": {
        "upstreamRank": { "state": "not-yet" },
        "note": "upstreamRank has never been observed for this Attempt and must read not-yet, not unavailable." }
    },

    { "id": "ranking-row1-oncourse-tcp-beats-later-cis",
      "invariant": "ranking-row-1",
      "description": "Row 1 of SS4's table (tcp > cis for on-course facts): a later, disagreeing cis observation does not displace an already-presented tcp one.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "onCoursePosition", "source": "tcp", "observedAt": "2026-09-15T10:00:00.500Z",
          "value": { "runSeconds": 42.10 }, "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "onCoursePosition", "source": "cis", "observedAt": "2026-09-15T10:00:02.000Z",
          "value": { "runSeconds": 41.80 }, "confidence": "authoritative" }
      ],
      "expect": {
        "onCoursePosition": { "state": "known", "value": { "runSeconds": 42.10 }, "source": "tcp",
                               "confidence": "authoritative", "provisional": false },
        "note": "tcp outranks cis for this category; a later, higher-timestamped cis reading does not win." }
    },

    { "id": "ranking-row2-cis-configured-tcp-then-cis-confirms",
      "invariant": "ranking-row-2",
      "description": "Finished slalom outcome, CIS configured: tcp's inferred value is presented until cis reports, then cis becomes presented and provisional clears.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:14:02.083Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "inferred" }
      ],
      "expectSequence": [
        { "afterGivenIndex": 0,
          "expect": { "outcome": { "state": "known",
                                    "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
                                    "source": "tcp", "confidence": "inferred", "provisional": true } } }
      ],
      "then": [
        { "ingestSeq": 2, "field": "outcome", "source": "cis", "observedAt": "2026-09-15T10:14:11.400Z",
          "eventTime": "2026-09-15T10:14:02.070Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" }
      ],
      "expect": {
        "outcome": { "state": "known",
                     "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
                     "source": "cis", "confidence": "authoritative", "eventTime": "2026-09-15T10:14:02.070Z",
                     "provisional": false } }
    },

    { "id": "ranking-row2-cis-configured-tcp-does-not-override-cis",
      "invariant": "ranking-row-2",
      "description": "Once cis has reported and remains available, a later tcp Results rotation touching the same field does not displace it, agreement or not — the fix for the flicker found in the adversarial pass.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "outcome", "source": "cis", "observedAt": "2026-09-15T10:14:11.400Z",
          "eventTime": "2026-09-15T10:14:02.070Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:14:32.000Z",
          "eventTime": "2026-09-15T10:14:02.079Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" }
      ],
      "expect": {
        "outcome": { "state": "known", "source": "cis", "confidence": "authoritative",
                     "eventTime": "2026-09-15T10:14:02.070Z", "provisional": false },
        "note": "presented value/provenance is unchanged by ingestSeq 2 — cis remains top-ranked and available." }
    },

    { "id": "ranking-row2-no-cis-tcp-self-corrects",
      "invariant": "ranking-row-2",
      "description": "Finished slalom outcome, CIS not configured: tcp's own later Results-row observation supersedes its earlier OnCourse-derived one, and provisional clears immediately since nothing more authoritative is coming.",
      "context": { "cisConfigured": false },
      "given": [
        { "ingestSeq": 1, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:14:02.083Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "inferred" },
        { "ingestSeq": 2, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:14:28.000Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" }
      ],
      "expect": {
        "outcome": { "state": "known", "source": "tcp", "confidence": "authoritative", "provisional": false },
        "note": "provisional:false because no CIS is configured for this deployment, per SS1.2's provisional definition — not because the value is any less mechanically derived." }
    },

    { "id": "ranking-row2-xml-only-fallback-after-restart",
      "invariant": "ranking-row-2",
      "description": "Row 2's third-ranked source: after a restart, before TCP's rotation has caught up to this RaceId again, a fresh XML read supplies the outcome, presented as the best available.",
      "context": { "cisConfigured": false },
      "given": [
        { "ingestSeq": 1, "field": "outcome", "source": "xml", "observedAt": "2026-09-15T11:00:00.000Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" }
      ],
      "expect": { "outcome": { "state": "known", "source": "xml", "confidence": "authoritative", "provisional": true },
                  "note": "provisional:true — tcp outranks xml for this category and is expected to report again once its rotation reaches this RaceId; xml is presented only because nothing higher-ranked has reported yet." }
    },

    { "id": "ranking-row3-upstreamrank-cis-beats-tcp",
      "invariant": "ranking-row-3",
      "description": "Row 3 (cis > tcp for upstreamRank): a later cis Rank supersedes an earlier tcp one.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "upstreamRank", "source": "tcp", "observedAt": "2026-09-15T10:14:05.000Z",
          "value": 3, "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "upstreamRank", "source": "cis", "observedAt": "2026-09-15T10:14:12.000Z",
          "value": 2, "confidence": "authoritative" }
      ],
      "expect": { "upstreamRank": { "state": "known", "value": 2, "source": "cis", "confidence": "authoritative", "provisional": false } }
    },

    { "id": "ranking-row4-phasestatus-tcp-beats-xml",
      "invariant": "ranking-row-4",
      "description": "Row 4 (tcp > xml for Phase.status): xml disagreeing does not override tcp once tcp has reported.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "status", "source": "tcp", "observedAt": "2026-09-15T09:30:00.000Z",
          "value": "running", "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "status", "source": "xml", "observedAt": "2026-09-15T09:30:05.000Z",
          "value": "scheduled", "confidence": "authoritative" }
      ],
      "expect": { "status": { "state": "known", "value": "running", "source": "tcp", "confidence": "authoritative", "provisional": false } }
    },

    { "id": "ranking-row4-phasestatus-xml-fallback",
      "invariant": "ranking-row-4",
      "description": "Before tcp has reported this Phase's status at all, xml — the only source that has reported — is presented.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "status", "source": "xml", "observedAt": "2026-09-15T09:29:00.000Z",
          "value": "scheduled", "confidence": "authoritative" }
      ],
      "expect": { "status": { "state": "known", "value": "scheduled", "source": "xml", "confidence": "authoritative", "provisional": true },
                  "note": "provisional:true — tcp, the higher-ranked source for this field, has not yet reported and is configured/expected." }
    },

    { "id": "inv2c-stale-cis-eventtime-refused",
      "invariant": "INV-2c",
      "description": "A higher-ranked observation whose eventTime is strictly earlier than the presented value's does not supersede it, regardless of rank.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:14:02.083Z",
          "eventTime": "2026-09-15T10:14:02.079Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "outcome", "source": "cis", "observedAt": "2026-09-15T10:14:11.400Z",
          "eventTime": "2026-09-15T09:58:00.000Z",
          "value": { "kind": "duration", "runSeconds": 81.90, "penaltySeconds": 0, "totalSeconds": 81.90 },
          "confidence": "authoritative" }
      ],
      "expect": {
        "outcome": { "state": "known",
                     "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
                     "source": "tcp", "eventTime": "2026-09-15T10:14:02.079Z", "provisional": false },
        "note": "cis outranks tcp for this category, but its eventTime is nine minutes older than what is already known — INV-2c refuses it." }
    },

    { "id": "inv2c-does-not-apply-without-eventtime",
      "invariant": "INV-2c",
      "description": "Where the candidate carries no eventTime at all (upstreamRank never does), INV-2c has nothing to compare and ordinary INV-2 ranking governs alone.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "upstreamRank", "source": "tcp", "observedAt": "2026-09-15T10:14:05.000Z",
          "value": 3, "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "upstreamRank", "source": "cis", "observedAt": "2026-09-15T10:14:04.000Z",
          "value": 2, "confidence": "authoritative" }
      ],
      "expect": { "upstreamRank": { "state": "known", "value": 2, "source": "cis", "confidence": "authoritative", "provisional": false },
                  "note": "cis wins on rank alone, even though its observedAt is earlier than tcp's — neither field carries eventTime, so INV-2c is not in play and only INV-2's table decides." }
    },

    { "id": "inv2b-lower-ranked-disagreement-does-not-silently-adopt",
      "invariant": "INV-2b",
      "description": "The observable-value half of INV-2b: a lower-ranked source's disagreement never becomes presented directly. (The re-query-trigger half is not expressible as a value vector — see CONFORMANCE-VECTORS.md's 'could not write' section.)",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "outcome", "source": "cis", "observedAt": "2026-09-15T10:14:11.400Z",
          "eventTime": "2026-09-15T10:14:02.070Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T14:02:11.000Z",
          "eventTime": "2026-09-15T10:14:02.079Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 2, "totalSeconds": 84.36 },
          "confidence": "authoritative" }
      ],
      "expect": {
        "outcome": { "state": "known", "value": { "totalSeconds": 82.36 }, "source": "cis", "provisional": false },
        "note": "tcp's disagreeing, later, PenaltyCorrection-driven reading is never adopted directly from this vector alone — only a fresh response from cis itself (a distinct, later ingestSeq observation with source:'cis') would change what is presented." }
    },

    { "id": "trichotomy-known-zero-not-confused-with-absence",
      "invariant": "trichotomy",
      "description": "A real, asserted zero is structurally distinct from not-yet and unavailable — the direct fix for Exhibit 5.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:20:00.000Z",
          "value": { "kind": "duration", "runSeconds": 79.10, "penaltySeconds": 0, "totalSeconds": 79.10 },
          "confidence": "authoritative" }
      ],
      "expect": {
        "outcome": { "state": "known",
                     "value": { "kind": "duration", "runSeconds": 79.10, "penaltySeconds": 0, "totalSeconds": 79.10 },
                     "source": "tcp", "confidence": "authoritative" },
        "note": "penaltySeconds: 0 is a `known` value, not `not-yet` or `unavailable` — a clean run, not an unjudged one." }
    },

    { "id": "trichotomy-unavailable-persists-explicitly",
      "invariant": "trichotomy",
      "description": "unavailable{reason} is asserted, not defaulted, and persists as an explicit state distinct from not-yet.",
      "context": { "cisConfigured": false },
      "given": [
        { "ingestSeq": 1, "field": "run1Gates", "state": "unavailable", "reason": "not-observed-live-and-cis-unavailable",
          "observedAt": "2026-09-15T09:00:00.000Z" }
      ],
      "expect": { "run1Gates": { "state": "unavailable", "reason": "not-observed-live-and-cis-unavailable" },
                  "note": "distinct from a field simply never having been observed (not-yet, see inv1-unavailable-never-defaulted) — this one is an explicit domain-layer determination." }
    },

    { "id": "inv4-entry-correction-is-a-field-update",
      "invariant": "INV-4",
      "description": "A correction to who raced under a bib is a normal known-to-known transition, not a structural rebind.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "entry", "source": "tcp", "observedAt": "2026-09-15T08:00:00.000Z",
          "value": { "entryId": "30034.K1M_ST" }, "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "entry", "source": "operator-write", "observedAt": "2026-09-20T11:00:00.000Z",
          "value": { "entryId": "30099.K1M_ST" }, "confidence": "authoritative" }
      ],
      "expect": { "entry": { "state": "known", "value": { "entryId": "30099.K1M_ST" }, "source": "operator-write",
                              "confidence": "authoritative", "provisional": false },
                  "note": "attemptId is unchanged by this — it is keyed on (phaseId, bib), never on entry." }
    },

    { "id": "inv5-identical-redelivery-is-a-noop",
      "invariant": "INV-5",
      "description": "Re-delivering an identical observation does not alter presented state.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:14:02.083Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:14:02.083Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" }
      ],
      "expect": { "outcome": { "state": "known", "observedAt": "2026-09-15T10:14:02.083Z", "source": "tcp" },
                  "note": "ingestSeq 2 is byte-identical to ingestSeq 1 (same value, same observedAt, same source) and must not be treated as a new client-visible change." }
    },

    { "id": "inv6-clock-jump-does-not-reorder-merge",
      "invariant": "INV-6",
      "description": "A wall-clock jump backward between two observations does not let the earlier-clocked, later-arrived one win — ordering is by ingestSeq, never by observedAt.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "status", "source": "tcp", "observedAt": "2026-09-15T10:30:00.000Z",
          "value": "running", "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "status", "source": "tcp", "observedAt": "2026-09-15T10:15:00.000Z",
          "value": "paused", "confidence": "authoritative" }
      ],
      "expect": { "status": { "state": "known", "value": "paused", "source": "tcp", "confidence": "authoritative" },
                  "note": "ingestSeq 2's observedAt (10:15) is EARLIER than ingestSeq 1's (10:30) — an NTP correction between them — but ingestSeq 2 is still the later observation and still wins; a naive observedAt comparison would have kept 'running'." }
    },

    { "id": "operator-write-provisional-presented-immediately",
      "invariant": "operator-write",
      "description": "An optimistic write is presented the instant it is submitted, regardless of ranking, superseding whatever a lower- or higher-ranked automated source last showed.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "gates", "source": "tcp", "observedAt": "2026-09-15T14:02:00.000Z",
          "value": [ { "number": 4, "penalty": 0 } ], "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "gates", "source": "operator-write", "observedAt": "2026-09-15T14:02:11.000Z",
          "value": [ { "number": 4, "penalty": 2 } ], "confidence": "authoritative" }
      ],
      "expect": { "gates": { "state": "known", "value": [ { "number": 4, "penalty": 2 } ],
                              "source": "operator-write", "provisional": true } }
    },

    { "id": "operator-write-confirmed-by-matching-echo",
      "invariant": "operator-write",
      "description": "A subsequent tcp observation matching the requested value confirms the write; presentation is unchanged in value, only in provenance.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "gates", "source": "operator-write", "observedAt": "2026-09-15T14:02:11.000Z",
          "value": [ { "number": 4, "penalty": 2 } ], "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "gates", "source": "tcp", "observedAt": "2026-09-15T14:02:14.500Z",
          "value": [ { "number": 4, "penalty": 2 } ], "confidence": "authoritative" }
      ],
      "expect": { "gates": { "state": "known", "value": [ { "number": 4, "penalty": 2 } ],
                              "source": "tcp", "provisional": false },
                  "writeRequest": { "status": "confirmed" } }
    },

    { "id": "operator-write-mismatched-echo-wins",
      "invariant": "operator-write",
      "description": "A subsequent tcp observation that DISAGREES with the requested value becomes presented — the domain layer never keeps asserting what was requested once the record of truth says otherwise.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "gates", "source": "operator-write", "observedAt": "2026-09-15T14:02:11.000Z",
          "value": [ { "number": 4, "penalty": 2 } ], "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "gates", "source": "tcp", "observedAt": "2026-09-15T14:02:14.500Z",
          "value": [ { "number": 4, "penalty": 50 } ], "confidence": "authoritative" }
      ],
      "expect": { "gates": { "state": "known", "value": [ { "number": 4, "penalty": 50 } ],
                              "source": "tcp", "provisional": false },
                  "writeRequest": { "status": "mismatched", "confirmedValue": [ { "number": 4, "penalty": 50 } ] },
                  "note": "both facts are visible: the field shows the true echoed value, and the WriteRequest separately records the mismatch." }
    },

    { "id": "operator-write-provisional-false-not-superseded-by-incidental-report",
      "invariant": "operator-write",
      "description": "A no-echo-expected assertion (provisional:false) is not superseded by a routine, incidental automated report the way a provisional:true write is by its very next observation.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "entry", "source": "operator-write", "observedAt": "2026-09-22T09:00:00.000Z",
          "value": { "entryId": "30099.K1M_ST" }, "confidence": "authoritative", "provisionalOverride": false },
        { "ingestSeq": 2, "field": "entry", "source": "tcp", "observedAt": "2026-09-22T09:05:00.000Z",
          "value": { "entryId": "30034.K1M_ST" }, "confidence": "authoritative" }
      ],
      "expect": { "entry": { "state": "known", "value": { "entryId": "30099.K1M_ST" }, "source": "operator-write" },
                  "note": "the direct correction (no echo ever expected, since the on-site session that produced ingestSeq 2 predates it and there is nothing further to await) is not displaced by an automated tcp observation ranked below it — only a later human assertion or a specifically-triggered top-source re-read would supersede it." }
    },

    { "id": "two-run-br1-untouched-by-br2",
      "invariant": "two-run",
      "description": "BR1's own cached Attempt is untouched by anything in BR2's message stream — the worked example in CONTRACTS.md SS2.11, as a vector.",
      "context": { "cisConfigured": false },
      "given": [
        { "ingestSeq": 1, "attemptId": "K1M_ST_BR1_6:9", "field": "outcome", "source": "tcp",
          "observedAt": "2026-09-15T09:40:00.000Z",
          "value": { "kind": "duration", "runSeconds": 85.10, "penaltySeconds": 2, "totalSeconds": 87.10 },
          "confidence": "authoritative" },
        { "ingestSeq": 2, "attemptId": "K1M_ST_BR2_6:9", "field": "outcome", "source": "tcp",
          "observedAt": "2026-09-15T10:14:28.000Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" }
      ],
      "expect": {
        "K1M_ST_BR1_6:9.outcome": { "state": "known", "value": { "totalSeconds": 87.10 }, "source": "tcp" },
        "K1M_ST_BR2_6:9.outcome": { "state": "known", "value": { "totalSeconds": 82.36 }, "source": "tcp" },
        "note": "two distinct Attempts (distinct phaseId), not one field with two values — nothing in BR2's row mentions BR1's attemptId at all." }
    },

    { "id": "two-run-br1-recovered-via-cis-after-restart",
      "invariant": "two-run",
      "description": "BR1 never observed live (server restarted between runs); CIS configured — full recovery via GetResult against BR1's own RaceId.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "attemptId": "K1M_ST_BR1_6:9", "field": "outcome", "source": "cis",
          "observedAt": "2026-09-15T10:20:00.000Z", "eventTime": "2026-09-15T09:40:00.000Z",
          "value": { "kind": "duration", "runSeconds": 85.10, "penaltySeconds": 2, "totalSeconds": 87.10 },
          "confidence": "authoritative" },
        { "ingestSeq": 2, "attemptId": "K1M_ST_BR1_6:9", "field": "gates", "source": "cis",
          "observedAt": "2026-09-15T10:20:00.000Z",
          "value": [ { "number": 12, "penalty": 2 } ], "confidence": "authoritative" }
      ],
      "expect": {
        "K1M_ST_BR1_6:9.outcome": { "state": "known", "value": { "totalSeconds": 87.10 }, "source": "cis", "provisional": false },
        "K1M_ST_BR1_6:9.gates": { "state": "known", "source": "cis" } }
    },

    { "id": "two-run-br1-recovered-via-xml-no-live-no-cis",
      "invariant": "two-run",
      "description": "BR1 never observed live, CIS not configured: full recovery from the XML snapshot's own frozen run-1 row and run-2's BetterRunNr/Prev* fields — the primary path, checked against a real two-day event where this was the only one available all weekend.",
      "context": { "cisConfigured": false, "xmlAvailable": true },
      "given": [
        { "ingestSeq": 1, "attemptId": "K1M_ST_BR1_6:9", "field": "outcome", "source": "xml",
          "observedAt": "2026-09-15T10:20:00.000Z", "eventTime": "2026-09-15T09:40:00.000Z",
          "value": { "kind": "duration", "runSeconds": 85.10, "penaltySeconds": 2, "totalSeconds": 87.10 },
          "confidence": "authoritative" },
        { "ingestSeq": 2, "attemptId": "K1M_ST_BR1_6:9", "field": "gates", "source": "xml",
          "observedAt": "2026-09-15T10:20:00.000Z",
          "value": [ { "number": 12, "penalty": 2 } ], "confidence": "authoritative" }
      ],
      "expect": {
        "K1M_ST_BR1_6:9.outcome": { "state": "known", "value": { "totalSeconds": 87.10 }, "source": "xml", "provisional": false },
        "K1M_ST_BR1_6:9.gates": { "state": "known", "source": "xml" },
        "note": "confidence: authoritative, not inferred — the snapshot's own fields are Canoe123 stating a fact directly, the same standing a TCP field has." }
    },

    { "id": "two-run-br1-unavailable-no-cache-no-xml-no-cis",
      "invariant": "two-run",
      "description": "BR1 never observed live, XML unreadable, CIS not configured: the one genuinely unrecoverable case, now requiring all three paths to fail rather than just CIS — and only once BR2's own arrival lets the domain layer conclude BR1's detail SHOULD exist, per the trigger condition made explicit in DERIVATIONS.md SS4.5.",
      "context": { "cisConfigured": false, "xmlAvailable": false },
      "given": [
        { "ingestSeq": 1, "attemptId": "K1M_ST_BR2_6:9", "field": "outcome", "source": "tcp",
          "observedAt": "2026-09-15T10:14:28.000Z",
          "value": { "kind": "duration", "runSeconds": 82.36, "penaltySeconds": 0, "totalSeconds": 82.36 },
          "confidence": "authoritative" }
      ],
      "expect": {
        "K1M_ST_BR1_6:9.outcome": { "state": "unavailable", "reason": "not-observed-live-and-cis-unavailable" },
        "K1M_ST_BR1_6:9.gates": { "state": "unavailable", "reason": "not-observed-live-and-cis-unavailable" },
        "note": "before ingestSeq 1 (BR2 arriving), K1M_ST_BR1_6:9.outcome must read not-yet, not unavailable — see inv1-unavailable-never-defaulted and DERIVATIONS.md SS4.5's trigger condition." }
    },

    { "id": "cross-outcome-not-yet-before-operator-entry",
      "invariant": "cross-outcome",
      "description": "Before the operator enters heat order, a Cross Attempt's outcome is not-yet — never inferred from Gates-fill progress.",
      "context": { "cisConfigured": false },
      "given": [
        { "ingestSeq": 1, "attemptId": "WX1_XS_26:4", "field": "status", "source": "tcp",
          "observedAt": "2026-09-15T11:00:00.000Z", "value": "on-course", "confidence": "authoritative" }
      ],
      "expect": { "WX1_XS_26:4.outcome": { "state": "not-yet" } }
    },

    { "id": "cross-outcome-operator-asserted",
      "invariant": "cross-outcome",
      "description": "The operator's heat-order entry is presented immediately, authoritative, with no eventTime.",
      "context": { "cisConfigured": false },
      "given": [
        { "ingestSeq": 1, "attemptId": "WX1_XS_26:4", "field": "outcome", "source": "operator-assertion",
          "observedAt": "2026-09-15T11:03:40.000Z", "value": { "kind": "ordinal", "order": 2 },
          "confidence": "authoritative" }
      ],
      "expect": { "WX1_XS_26:4.outcome": { "state": "known", "value": { "kind": "ordinal", "order": 2 },
                                            "source": "operator-assertion", "confidence": "authoritative",
                                            "provisional": false },
                  "note": "no eventTime — Cross has none to give." }
    },

    { "id": "cross-outcome-corrected-after-next-heat-started",
      "invariant": "cross-outcome",
      "description": "A later correction to heat order lands and is presented even after the next heat has started — the deadline in ARCHITECTURE.md SS6.D governs the original assertion's timeliness and display prominence, never whether a correction is accepted.",
      "context": { "cisConfigured": false },
      "given": [
        { "ingestSeq": 1, "attemptId": "WX1_XS_26:4", "field": "outcome", "source": "operator-assertion",
          "observedAt": "2026-09-15T11:03:40.000Z", "value": { "kind": "ordinal", "order": 2 },
          "confidence": "authoritative" },
        { "ingestSeq": 2, "attemptId": "WX1_XS_26:1", "field": "status", "source": "tcp",
          "observedAt": "2026-09-15T11:05:00.000Z", "value": "on-course", "confidence": "authoritative",
          "note-only": "the next heat's first competitor appearing — not itself part of the assertion under test" },
        { "ingestSeq": 3, "attemptId": "WX1_XS_26:4", "field": "outcome", "source": "operator-assertion",
          "observedAt": "2026-09-15T11:06:10.000Z", "value": { "kind": "ordinal", "order": 3 },
          "confidence": "authoritative" }
      ],
      "expect": { "WX1_XS_26:4.outcome": { "state": "known", "value": { "kind": "ordinal", "order": 3 },
                                            "source": "operator-assertion" } }
    },

    { "id": "ongoing-recomputation-provisional-total-revised-by-late-gate",
      "invariant": "ongoing-recomputation",
      "description": "DERIVATIONS.md SS4.3's fix: a finishing Attempt's mechanically-computed outcome keeps updating as trailing gate judgements arrive, rather than freezing at the dtFinish instant.",
      "context": { "cisConfigured": false },
      "given": [
        { "ingestSeq": 1, "field": "status", "source": "tcp", "observedAt": "2026-09-15T10:32:22.370Z",
          "eventTime": "2026-09-15T10:32:22.370Z", "value": "finished", "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:32:22.370Z",
          "value": { "kind": "duration", "runSeconds": 83.55, "penaltySeconds": 2, "totalSeconds": 85.55 },
          "confidence": "inferred" }
      ],
      "expectSequence": [
        { "afterGivenIndex": 1,
          "expect": { "outcome": { "state": "known", "value": { "totalSeconds": 85.55 }, "provisional": true } } }
      ],
      "then": [
        { "ingestSeq": 3, "field": "outcome", "source": "tcp", "observedAt": "2026-09-15T10:32:24.170Z",
          "value": { "kind": "duration", "runSeconds": 83.55, "penaltySeconds": 4, "totalSeconds": 87.55 },
          "confidence": "inferred" }
      ],
      "expect": {
        "status": { "state": "known", "value": "finished" },
        "outcome": { "state": "known", "value": { "totalSeconds": 87.55 }, "source": "tcp",
                     "confidence": "inferred", "provisional": true },
        "note": "the last gate judged at ingestSeq 3 (a further 2-point touch) revises the total from 85.55 to 87.55, seconds after status already read 'finished' at ingestSeq 1 — status and outcome are independent fields, per SS4.1's provisional note." }
    },

    { "id": "phasestatus-official-to-revised-skips-unofficial",
      "invariant": "phase-status-transition",
      "description": "official -> revised is legal directly, without passing back through unofficial, per the maintainer's answer on corrections.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "status", "source": "tcp", "observedAt": "2026-09-15T13:00:00.000Z",
          "value": "official", "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "status", "source": "tcp", "observedAt": "2026-09-20T09:00:00.000Z",
          "value": "revised", "confidence": "authoritative" }
      ],
      "expect": { "status": { "state": "known", "value": "revised", "source": "tcp" } }
    },

    { "id": "attemptstatus-finished-to-dsq-post-finish",
      "invariant": "attempt-status-transition",
      "description": "A post-finish disqualification is a legal transition, not a rejected regression.",
      "context": { "cisConfigured": true },
      "given": [
        { "ingestSeq": 1, "field": "status", "source": "tcp", "observedAt": "2026-09-15T10:14:02.083Z",
          "eventTime": "2026-09-15T10:14:02.079Z", "value": "finished", "confidence": "authoritative" },
        { "ingestSeq": 2, "field": "status", "source": "tcp", "observedAt": "2026-09-15T10:20:00.000Z",
          "value": "dsq", "confidence": "authoritative" }
      ],
      "expect": { "status": { "state": "known", "value": "dsq", "source": "tcp" } }
    },

    { "id": "standing-tie-default-skip-rank",
      "invariant": "standing-tiebreak",
      "description": "Equal mechanical outcomes get equal rank by default — no invented tie-break.",
      "context": { "cisConfigured": true },
      "given": [
        { "entryId": "A", "outcome": { "kind": "duration", "totalSeconds": 90.00 } },
        { "entryId": "B", "outcome": { "kind": "duration", "totalSeconds": 90.00 } },
        { "entryId": "C", "outcome": { "kind": "duration", "totalSeconds": 91.50 } }
      ],
      "expect": { "standing": [
        { "entryId": "A", "rank": 1 }, { "entryId": "B", "rank": 1 }, { "entryId": "C", "rank": 3 } ],
        "note": "skip ranking — the entry after a tied pair gets rank 3, not 2." }
    },

    { "id": "standing-tie-resolved-by-upstreamrank",
      "invariant": "standing-tiebreak",
      "description": "An explicit upstreamRank differentiating a mechanically-tied pair resolves it with sequential, non-skip ranks.",
      "context": { "cisConfigured": true },
      "given": [
        { "entryId": "A", "outcome": { "kind": "duration", "totalSeconds": 90.00 }, "upstreamRank": 2 },
        { "entryId": "B", "outcome": { "kind": "duration", "totalSeconds": 90.00 }, "upstreamRank": 1 },
        { "entryId": "C", "outcome": { "kind": "duration", "totalSeconds": 91.50 } }
      ],
      "expect": { "standing": [
        { "entryId": "B", "rank": 1 }, { "entryId": "A", "rank": 2 }, { "entryId": "C", "rank": 3 } ] }
    },

    { "id": "standing-no-result-gets-null-rank",
      "invariant": "standing-tiebreak",
      "description": "A no-result outcome never receives a fabricated numeric rank.",
      "context": { "cisConfigured": true },
      "given": [
        { "entryId": "A", "outcome": { "kind": "duration", "totalSeconds": 90.00 } },
        { "entryId": "B", "outcome": { "kind": "no-result", "status": "dsq" } }
      ],
      "expect": { "standing": [
        { "entryId": "A", "rank": 1 }, { "entryId": "B", "rank": null, "status": "dsq" } ] }
    },

    { "id": "standing-anomaly-upstream-rank-disagrees-nontied",
      "invariant": "standing-tiebreak",
      "description": "An upstream Rank disagreeing with a non-tied mechanical ordering never wins silently — the mechanical order stands and the disagreement is recorded.",
      "context": { "cisConfigured": true },
      "given": [
        { "entryId": "A", "outcome": { "kind": "duration", "totalSeconds": 88.00 }, "upstreamRank": 2 },
        { "entryId": "B", "outcome": { "kind": "duration", "totalSeconds": 90.00 }, "upstreamRank": 1 }
      ],
      "expect": { "standing": [ { "entryId": "A", "rank": 1 }, { "entryId": "B", "rank": 2 } ],
                  "anomalies": [ { "kind": "rank-disagreement", "entryId": "B", "ourRank": 2, "upstreamRank": 1 } ] }
    }
  ]
}
